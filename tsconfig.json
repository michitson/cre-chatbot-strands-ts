{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowJs": false,
    "types": ["node", "aws-lambda"]
  },
  "include": ["amplify/**/*", "tests/**/*"],
  "exclude": ["node_modules", "reference-python", "reference-frontend", ".amplify"]
}
